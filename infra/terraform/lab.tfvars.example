# Disposable one-hour internship-report lab.
# The production/design defaults remain a 120-minute lookback and two AI tasks.
lookback_window_minutes = 30

ai_engine_desired_count = 1
ai_engine_min_capacity  = 1
ai_engine_max_capacity  = 4

enable_acm = false
alert_email = "vinhnt.23it@vku.udn.vn"

# Lab data is disposable. Keep both false outside short-lived sandbox runs.
evidence_force_destroy = true
ecr_force_delete       = true

